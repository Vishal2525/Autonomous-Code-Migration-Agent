# ── LLM provider ─────────────────────────────────────────────
# Which provider the agent uses: "gemini" or "groq"
LLM_PROVIDER=groq

# API keys (set only the one you use; never commit real keys)
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model overrides (free-tier friendly defaults)
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ─────────────────────────────────────────────────
# Local instance or a MongoDB Atlas SRV string, e.g.:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# The database name always comes from MONGODB_DB (not the URI path).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=code_migration_agent

# ── Agent behaviour ──────────────────────────────────────────
# AUTO = run end-to-end; HITL = pause for approval at key gates
DEFAULT_MODE=AUTO
MAX_REPAIR_ATTEMPTS=5
MAX_AGENT_ITERATIONS=30

# Simulated crash for testing the resume system: the worker process
# raises immediately after this task id checkpoints, e.g. TASK-003
CRASH_AFTER_TASK=

# ── Timeouts (seconds) ───────────────────────────────────────
CLONE_TIMEOUT=300
TOOL_TIMEOUT=60
TEST_TIMEOUT=600
PIP_TIMEOUT=900
